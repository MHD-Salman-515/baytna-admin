# Copy to .env.local (gitignored) and fill in.

# Backend base URL. The ONLY variable exposed to the browser.
NEXT_PUBLIC_API_BASE_URL=https://baytna-api-z7v9.onrender.com/api/v1

# Development only. Lets the login screen autofill the OTP from
# GET /dev/last-otp. Read server-side by app/api/dev/otp/route.dev.ts, which
# is not compiled into production builds. Never set this on Vercel.
DEV_OTP_KEY=
